# Copy this file to .env and adjust values as needed.

# Model to load (Hugging Face model ID)
MODEL_ID=hamzab/roberta-fake-news-classification

# HuggingFace cache directory (relative to backend folder)
HF_CACHE_DIR=.hf_cache

# Maximum article length in characters accepted by the API
MAX_ARTICLE_LENGTH=5000

# LIME number of perturbation samples (higher = more accurate but slower)
LIME_NUM_SAMPLES=300

# CORS origin for local frontend
CORS_ORIGIN=http://localhost:5173

# Device: "auto" lets the app pick cuda if available, else cpu
DEVICE=auto
